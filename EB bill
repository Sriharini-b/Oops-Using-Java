package eb_bill;
import java.util.Scanner;
public class EB_BILL 
{
    int units;
    String type;
    public static void main(String[] args)
    {
        int bill=0;
        Scanner in= new Scanner(System.in);
        System.out.print("Connection type:");
        String type=in.nextLine();
        System.out.print("Units consumed: ");
        int units=in.nextInt();
        if(type.equals("Domestic"))
        {
            if (units<=100)
                bill=0;
            else if (units<=200)
                bill=(units-100)*2;
            else if (units<=500)
                bill=200+(units-200)*4;
            else
                bill=1400+(units-500)*6;
        }
        else if (type.equals("Comercial"))
        {
            if (units<=100)
                bill=units*2;
            else if (units<=200)
                bill=200+(units-100)*4;
            else if(units<=500)
                bill=600+(units-200)*6;
            else
                bill=2400+(units-500)*7;   
        }
        else
        {
            System.out.println("Invalid input type");      
        }
    System.out.println("Amount to be Paid:Rs."+bill);
    }
}
